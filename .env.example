# Optional — enables live Gemini narration for the AI module.
# Without it, CITYTRACE uses its deterministic rules engine and labels the
# output accordingly. Never commit a real key.
GEMINI_API_KEY=

# Persistence — Supabase project URL and service_role key (Settings → API).
# Without them, runtime data is kept in local temp files (fine for offline dev,
# but lost on serverless hosts such as Vercel). Server-only: never expose the
# service_role key to client code, and never commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies. Required in production — without it a built-in
# fallback secret is used, which anyone reading this repo could use to forge a
# session. Generate with: openssl rand -base64 32
CITYTRACE_AUTH_SECRET=
